{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MassiveNoobie/n0is-releases/blob/main/manifests/manifest.schema.json",
  "title": "n0is runtime manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release",
    "platform",
    "minimum_os",
    "components",
    "models"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "release": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,95}$"
    },
    "platform": {
      "const": "macos-arm64"
    },
    "minimum_os": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$"
    },
    "components": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "url",
          "sha256",
          "bytes",
          "entrypoint",
          "format",
          "source_url",
          "license_url"
        ],
        "properties": {
          "id": {
            "enum": [
              "ollama",
              "voice",
              "rug"
            ]
          },
          "version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,95}$"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 4096
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "entrypoint": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
          },
          "format": {
            "const": "tar.gz"
          },
          "protocol": {
            "const": "neo-asr-snapshots-v1"
          },
          "host_abi": {
            "const": 1
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 4096
          },
          "license_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 4096
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "id": {
                  "const": "voice"
                }
              }
            },
            "then": {
              "required": [
                "protocol"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "id": {
                  "const": "rug"
                }
              }
            },
            "then": {
              "required": [
                "host_abi"
              ]
            }
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "id": {
                "const": "ollama"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "voice"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "rug"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tag",
          "roles",
          "source_url",
          "license_url"
        ],
        "properties": {
          "tag": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*:[A-Za-z0-9][A-Za-z0-9._/-]*$"
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            }
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 4096
          },
          "license_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 4096
          }
        }
      }
    }
  }
}
